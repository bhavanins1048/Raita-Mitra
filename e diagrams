## 2. Entity-Relationship (ER) Diagram

The database is built on PostgreSQL via Supabase, with tables defined in [supabase_setup.sql](file:///c:/Users/Mala Mp/Desktop/agri/supabase_setup.sql). Below is the ER diagram representing tables and their relationships.

```mermaid
erDiagram
    FARMERS ||--o{ SOIL_REPORTS : "submits"
    FARMERS ||--o{ RECOMMENDATIONS : "receives"
    SOIL_REPORTS ||--o{ RECOMMENDATIONS : "generates"
    FERTILIZERS ||--o{ RECOMMENDATIONS : "is recommended in"

    FARMERS {
        uuid id PK "Primary Key (Auto-generated UUID)"
        string name "Farmer Name"
        string location "Farmer Location"
        timestamptz created_at "Timestamp of creation"
    }

    SOIL_REPORTS {
        uuid id PK "Primary Key (Auto-generated UUID)"
        uuid farmer_id FK "References farmers(id) (ON DELETE CASCADE)"
        string soil_type "Type of Soil (e.g. Red, Black, Sandy)"
        numeric nitrogen "Nitrogen levels (N)"
        numeric phosphorus "Phosphorus levels (P)"
        numeric potassium "Potassium levels (K)"
        numeric ph "Soil pH level"
        numeric moisture "Soil moisture percentage"
        timestamptz created_at "Timestamp of report submission"
    }

    FERTILIZERS {
        string id PK "Unique ID (e.g., 'f1', 'f2')"
        string fertilizer_name "Name of Fertilizer (e.g., Urea, DAP)"
        string_array suitable_soil "Array of compatible soils"
        string_array suitable_crop "Array of compatible crops"
        string quantity_per_acre "Recommended quantity"
        string water_requirement "Water level needs (Low/Medium/High)"
        string best_season "Optimal application season"
        string_array organic_alternatives "List of eco-friendly alternatives"
        numeric suitability_score "Scoring weight"
        timestamptz created_at "Timestamp of catalog creation"
    }

    RECOMMENDATIONS {
        uuid id PK "Primary Key (Auto-generated UUID)"
        uuid farmer_id FK "References farmers(id) (ON DELETE CASCADE)"
        uuid soil_report_id FK "References soil_reports(id) (ON DELETE CASCADE)"
        string crop_name "Target Crop chosen by farmer"
        string fertilizer_id FK "References fertilizers(id) (ON DELETE SET NULL)"
        jsonb recommendation_result "Structured JSON containing recommendations & plans"
        timestamptz created_at "Timestamp of generation"
    }
```

